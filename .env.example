TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key
POLL_INTERVAL_MS=15000

# Optional — re-added on every boot, so the wallet list survives restarts on
# hosts with an ephemeral filesystem (Render free tier). "address:label,address:label"
# TRACKED_WALLETS=0x84f8e5a324466deb7447048c014cf0245ce04afa:fibonacci,BXAWg4Jba...:mywallet

# Optional — Robinhood Chain (defaults to the free public endpoints)
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# ROBINHOOD_BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com/api/v2

# Optional — trading/scanner bots linked from each alert
# RICK_BOT_USERNAME=RickBurpBot
# BASED_BOT_USERNAME=based_eth_bot
